# Copy to .env and adjust as needed.
# If empty, the API client uses same-origin relative URLs. In development the
# Vite dev server proxies /api and /health to the backend (see vite.config.ts).
# For a production build served separately from the backend, point this at the
# backend origin explicitly, e.g.:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=