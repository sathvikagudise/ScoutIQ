# Copy to .env for local development, or set these in your host's environment.
# All values shown are the local-development defaults; nothing is required for
# the backend to start locally. Never commit a real .env.

# SQLAlchemy database URL. Local default is a SQLite file next to the app.
DATABASE_URL=sqlite:///./scoutiq.db

# ---------------------------------------------------------------------------
# CORS  (production frontend origin(s))
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to make credentialed
# (cookie-carrying) requests. Local development is same-origin through the
# Vite dev proxy, so localhost origins work by default and need no change.
#
# Production (Vercel frontend -> Render backend) MUST list the deployed
# frontend origin, e.g.:
#   CORS_ORIGINS=https://scout-iq-three.vercel.app
# Wildcard "*" is never used with credentials.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Session cookie  (cross-site deployments)
# ---------------------------------------------------------------------------
# Serve the session cookie with the Secure flag (HTTPS only): "true" for the
# HTTPS Render deployment.
# SESSION_COOKIE_SECURE=true
#
# SameSite attribute. Default "lax" works for same-origin/same-site setups
# (local development). For a Vercel frontend -> Render backend deployment the
# cookie must be shared cross-site, so set:
#   SESSION_COOKIE_SAMESITE=none
# "none" automatically forces Secure=true (browsers ignore SameSite=None
# cookies without the Secure flag).
# SESSION_COOKIE_SAMESITE=lax