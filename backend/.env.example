# Copy to .env for local development, or set these in your host's environment.
# All values shown are the local-development defaults; nothing is required for
# the backend to start locally. Never commit a real .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy database URL. Local default is a SQLite file next to the app.
# DATABASE_URL=sqlite:///./scoutiq.db
#
# Production (Render) must use an external, durable PostgreSQL database. Render
# provides a `postgresql://` URL in the "External" connection string form; the
# app normalizes it onto the bundled psycopg (v3) driver automatically.
#   DATABASE_URL=postgresql://user:password@host:5432/scoutiq
#
# A `postgres://` URL is also accepted and normalized the same way.

# ---------------------------------------------------------------------------
# CORS  (production frontend origin(s))
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to make requests. Local
# development is same-origin through the Vite dev proxy, so localhost origins
# work by default and need no change.
#
# Production (Vercel frontend -> Render backend) MUST list the deployed
# frontend origin, e.g.:
#   CORS_ORIGINS=https://scout-iq-three.vercel.app
# Wildcard "*" is never used. The `Authorization` header is always allowed by
# preflight (the backend CORS config allows all headers).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173